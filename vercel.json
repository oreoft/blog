{
  "buildCommand": "bundle exec jekyll build",
  "redirects": [
    {
      "source": "/zh",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/",
      "destination": "/",
      "permanent": true
    }
  ],
  "outputDirectory": "_site",
  "rewrites": [
    {
      "source": "/en/:path*",
      "destination": "/en/:path*/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/:path*/index.html"
    }
  ],
  "trailingSlash": true
}


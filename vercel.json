{
  "buildCommand": "bundle exec jekyll build",
  "redirects": [
    {
      "source": "/zh",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/",
      "destination": "/",
      "permanent": true
    }
  ],
  "outputDirectory": "_site",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/:path*/index.html"
    }
  ],
  "trailingSlash": true
}

